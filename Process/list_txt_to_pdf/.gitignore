# ===================================================================

# Python bytecode and runtime cache
__pycache__/
*.py[cod]
*$py.class

# PyInstaller compilation outputs and build directories
build/
dist/
*.manifest
*.spec

# Local application data and runtime artifacts
txt_to_pdf.lst
txt_to_pdf_merged.pdf
*_merged.pdf

# Embedded resources and fonts (copied locally for build purposes)
Arial.ttf

# System and OS metadata files
.DS_Store
Thumbs.db
